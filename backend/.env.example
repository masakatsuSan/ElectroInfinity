# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb+srv://:@cluster0.example.mongodb.net/userData
JWT_SECRET=your-very-long-random-jwt-secret-here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (image uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Images are uploaded into the "electro-infinity/blog" folder.

# ── Email / Brevo (OTP delivery — optional, not used by the blog) ─────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=College Connect

# ── YouTube (optional) ───────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key
