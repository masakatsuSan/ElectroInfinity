# ── Server ──────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
PORT=5000
# development | production
NODE_ENV=development
# Full MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/userData
# 32+ random characters — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-very-long-random-jwt-secret-here
# Access tokens are short-lived (15m); refresh tokens live 7 days
# and are stored hashed in the DB with rotation + reuse detection.
# (JWT_EXPIRES_IN is legacy and no longer used by the auth routes.)
JWT_EXPIRES_IN=15m

# ── Origins / CORS ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API and open
# Socket.IO connections. In production this must be the deployed
# frontend origin(s), e.g. https://college-connect.vercel.app
# Never leave this unset in production — an unset value falls back
# to FRONTEND_URL only.
ALLOWED_ORIGINS=http://localhost:5173
# Canonical frontend origin (fallback for CORS when ALLOWED_ORIGINS is unset)
FRONTEND_URL=http://localhost:5173
# Public API base URL the frontend uses when it is NOT proxied
# (production). Leave empty in development — the Vite dev server
# proxies /api to this server.
API_URL=

# ── Logging ─────────────────────────────────────────────────────────────
# pino level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Cloudinary (image uploads) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email / Brevo (OTP + contact form delivery) ────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=College Connect

# ── YouTube (optional) ─────────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key

# ── Security notes ─────────────────────────────────────────────────────
# - Cookies: access_token (httpOnly, 15m), refresh_token (httpOnly,
#   scoped to /api/auth, 7d), csrf_token (readable, double-submit).
#   In production they are Secure + SameSite=None (cross-origin API);
#   in development SameSite=Strict.
# - Rotate every value above if it was ever committed or shared.
